<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.batchmate.apitester</groupId>
	<artifactId>apitester-mule</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>mule-application</packaging>
	<name>apitester-mule</name>

	<!--
		MuleSoft (Mule 4) port of apitester-app's backend — same REST API surface (paths/JSON
		shapes) as the Spring Boot version, so apitester-ui can point at either interchangeably.
		No Camel here: the outbound HTTP call is Mule's own HTTP Request operation (TLS insecure —
		see global-config.xml's tls:context), not an embedded integration framework. Persistence is
		Oracle ONLY — the only database this app knows how to talk to (collections/requests/run
		logs/global vars/reports — see global-config.xml's Database_Config and schema.sql). No
		H2/PostgreSQL/MySQL support anywhere in this app.

		Deliberately NOT here: mule-json-module (JSON is handled natively by DataWeave —
		output/read "application/json" — nothing in this app ever used the JSON module's own
		operations), and GraalVM JS (was here at one point for a since-removed "${...}"-via-
		JavaScript templating engine, replaced with pure DataWeave — see templating.xml's "$(...)"
		syntax). Don't re-add either without a real new user for them; grep the whole src/main/mule
		tree for the relevant namespace/engine first to confirm there's nothing this comment forgot
		about.

		The Scripting module / Groovy / Apache POI ARE here, ONLY for Run All's Excel export
		(run-all-api.xml's build-excel-report) — this went client-side (ExcelJS, in apitester-ui)
		for a while and came back: ExcelJS 4.4.0's data-bar conditional formatting corrupts real
		Excel files (confirmed open/unfixed upstream bug, exceljs#3015 — see build-excel-report's
		own comment), so the export is server-side again, using a real POI XDDF bar chart instead
		of that broken code path. Don't re-migrate this to the frontend without checking that issue
		is actually fixed in whatever exceljs version would be pinned at the time.
	-->

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<app.runtime>4.6.16</app.runtime>
		<mule.maven.plugin.version>4.3.0</mule.maven.plugin.version>

		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-db-connector</artifactId>
			<version>1.16.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Oracle JDBC driver — the ONLY database this app persists to, via global-config.xml's
			 Database_Config. Publicly available on Maven Central, no licensed/authenticated
			 repo needed. -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<version>23.26.3.0.0</version>
		</dependency>

		<!-- Scripting module — ONLY user is run-all-api.xml's build-excel-report (engine="groovy").
			 No dedicated "Java module" connector on the public MuleSoft repo (only the private,
			 credential-gated Anypoint Exchange one, which isn't reachable here), so this is also
			 how Groovy gets a way to call POI's Java API directly. -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-scripting-module</artifactId>
			<version>2.1.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Groovy — the Scripting module's "groovy" engine, used ONLY for Run All's Excel export
			 (build-excel-report): POI's object-construction-heavy API reads far better as real
			 Groovy code than as DataWeave, and Groovy runs on the JVM so it can use POI directly. -->
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy</artifactId>
			<version>4.0.33</version>
		</dependency>
		<!-- Registers "groovy" as a JSR-223 ScriptEngine name (the plain groovy jar alone doesn't) —
			 needed for the Scripting module's engine="groovy" to resolve at all. -->
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
			<version>4.0.33</version>
		</dependency>

		<!-- Apache POI — Run All consolidated report xlsx export, same approach/version as
			 apitester-app's own ExcelReportService. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>

		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.10.5</version>
			<classifier>mule-plugin</classifier>
		</dependency>
	</dependencies>

	<build>
		<plugins>
		<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<sharedLibraries>
						<sharedLibrary>
							<groupId>com.oracle.database.jdbc</groupId>
							<artifactId>ojdbc11</artifactId>
						</sharedLibrary>
						<sharedLibrary>
							<groupId>org.apache.poi</groupId>
							<artifactId>poi-ooxml</artifactId>
						</sharedLibrary>
						<sharedLibrary>
							<groupId>org.apache.groovy</groupId>
							<artifactId>groovy</artifactId>
						</sharedLibrary>
						<sharedLibrary>
							<groupId>org.apache.groovy</groupId>
							<artifactId>groovy-jsr223</artifactId>
						</sharedLibrary>
					</sharedLibraries>
					<classifier>mule-application</classifier>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<layout>default</layout>
			<url>https://repository.mulesoft.org/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
</project>
